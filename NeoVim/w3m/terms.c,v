char
getch_select(int fd, int *fdn)
{
  int maxfd = tty;
  fd_set rset;

  if (fd < 0 || fd == tty) {
    *fdn = 0;
    return getch();
  }

  if (maxfd < fd)
    maxfd = fd;

  maxfd++;

  FD_ZERO(&rset);
  FD_SET(tty, &rset);
  FD_SET(fd, &rset);

  while (select(maxfd, &rset, NULL, NULL, NULL) < 1) {
    FD_ZERO(&rset);
    FD_SET(tty, &rset);
    FD_SET(fd, &rset);
  }

  if (FD_ISSET(tty, &rset)) {
    *fdn = 0;
    return getch();
  } else if (FD_ISSET(fd, &rset)) {
    *fdn = 1;
  }
  return 0;
}
#endif


