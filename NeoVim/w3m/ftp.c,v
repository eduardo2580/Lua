static char *
ftp_escape_str(char *str)
{
    Str s = Strnew();
    char *p, buf[5];
    unsigned char c;

    for (; (c = (unsigned char) *str) != '\0'; str++) {
	p = NULL;
	if (c < '!' || c > '~'
	    || c == '#' || c == '?' || c == '+'
	    || c == '&' || c == '<' || c == '>' || c == '"' || c == '%') {
	    sprintf(buf, "%%%02X", c);
	    p = buf;
	}
	if (p)
	    Strcat_charp(s, p);
	else
	    Strcat_char(s, *str);
    }
    return s->ptr;
}

