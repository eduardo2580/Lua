static void
ftp_fclose(FTP ftp)
{
    int control_closed = 0;

    if (ftp->rcontrol != NULL) {
	fclose(ftp->rcontrol);
	ftp->rcontrol = NULL;
	control_closed = 1;
    }
    if (ftp->wcontrol != NULL) {
	fclose(ftp->wcontrol);
	ftp->wcontrol = NULL;
	control_closed = 1;
    }
    if (control_closed && ftp->data != NULL) {
	fclose(ftp->data);
	ftp->data = NULL;
    }
    return;
}

