 func	"新タブで表示 (n)"	TAB_LINK	"nN"
 func	"リンクを保存 (A)"	SAVE_LINK	"A"
 func	"画像を表示   (i)"	VIEW_IMAGE	"i"
 func	"画像を保存   (I)"	SAVE_IMAGE	"I"
 func	"フレーム表示 (f)"	FRAME		"fF"
 nop	"────────"
