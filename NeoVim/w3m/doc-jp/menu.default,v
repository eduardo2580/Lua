@# A sample of ~/.w3m/menu  (default)
#
# menu MENU_ID
#  func  LABEL FUNCTION KEYS
#  popup LABEL MENU_ID  KEYS
#  nop   LABEL
# end
#
# MENU_ID
#  Main:   メインメニュー
#  Select: バッファ選択メニュー

menu Main
 func	"戻る         (b)"	BACK		"b"
 popup	"バッファ選択 (s)"	Select		"s"
