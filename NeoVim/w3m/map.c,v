<h1>Information about current page</h1>\n");
    if (buf == NULL)
	goto end;
    all = buf->allLine;
    if (all == 0 && buf->lastLine)
	all = buf->lastLine->linenumber;
#ifdef USE_M17N
    Strcat_charp(tmp, "<form method=internal action=charset>");
