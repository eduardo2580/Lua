#ifdef USE_MIGEMO
/* Migemo: romaji --> kana+kanji in regexp */
static char *
migemostr(char *str)
{
    FILE *f;
    Str tmp;

    tmp = Strnew_m_charp(migemo_command, " ", shell_quote(str), NULL);
    if (!(f = popen(tmp->ptr, "r")))
	return str;
    tmp = Strfgets(f);
    Strchop(tmp);
    pclose(f);
    return tmp->ptr;
}
#endif				/* USE_MIGEMO */

