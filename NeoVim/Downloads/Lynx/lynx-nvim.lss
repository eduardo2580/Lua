# Complete High-Contrast CSS 2.1 & HTML Color Style Sheet (.lss) for Lynx
# Format: object:attributes:foreground:background
# Valid attributes: normal, bold, dim, reverse, underline, blink, standout

# Base Screen & Defaults (Solid black background for maximum contrast)
normal:      normal:   brightwhite:black
default:     normal:   brightwhite:black

# Typography & Text Formatting
em:          bold:     brightcyan:black
strong:      bold:     brightyellow:black
b:           bold:     brightwhite:black
i:           normal:   brightcyan:black
u:           underline:brightyellow:black
s:           normal:   brightred:black
strike:      normal:   brightred:black
big:         bold:     brightwhite:black
small:       normal:   lightgray:black
sub:         normal:   brightcyan:black
sup:         normal:   brightmagenta:black
dfn:         normal:   brightgreen:black
abbr:        underline:brightgreen:black
acronym:     underline:brightgreen:black
q:           normal:   brightyellow:black
tt:          normal:   brightgreen:black
code:        normal:   brightgreen:black
samp:        normal:   brightgreen:black
kbd:         bold:     brightyellow:black
var:         normal:   brightmagenta:black
cite:        normal:   brightgreen:black
blockquote:  normal:   brightyellow:black
pre:         normal:   brightgreen:black

# Headings (CSS 2.1 Block Typography h1 - h6)
title:       bold:     white:blue
h1:          bold:     brightyellow:black
h2:          bold:     brightcyan:black
h3:          bold:     brightgreen:black
h4:          bold:     brightmagenta:black
h5:          bold:     brightwhite:black
h6:          bold:     lightgray:black

# Layout, Structure & Semantic Blocks (CSS 2.1 / HTML)
div:         normal:   brightwhite:black
span:        normal:   brightwhite:black
p:           normal:   brightwhite:black
address:     normal:   brightmagenta:black
center:      normal:   brightwhite:black
hr:          bold:     brightcyan:black
article:     normal:   brightwhite:black
section:     normal:   brightwhite:black
nav:         normal:   brightcyan:black
aside:       normal:   lightgray:black
header:      bold:     white:blue
footer:      normal:   lightgray:black
main:        normal:   brightwhite:black
figure:      normal:   brightyellow:black
figcaption:  normal:   brightyellow:black
details:     normal:   brightcyan:black
summary:     bold:     brightcyan:black
mark:        bold:     black:brightyellow
time:        normal:   brightcyan:black

# Image & Media Placeholders
img:         normal:   brightyellow:black
audio:       normal:   brightmagenta:black
video:       normal:   brightmagenta:black
canvas:      normal:   brightcyan:black
svg:         normal:   brightcyan:black

# Inline Revisions
ins:         normal:   brightgreen:black
del:         normal:   brightred:black

# Links & Anchors
a:           bold:     brightcyan:black
link:        bold:     brightcyan:black
alink:       bold:     black:brightyellow

# Navigation & Status Bars
status:      bold:     white:blue
alert:       bold:     white:red
whereis:     bold:     black:brightyellow

# Lists (ul, ol, dl)
ul:          normal:   brightwhite:black
ol:          normal:   brightwhite:black
li:          normal:   brightwhite:black
dl:          normal:   brightwhite:black
dt:          bold:     brightyellow:black
dd:          normal:   brightwhite:black
dir:         normal:   brightwhite:black
menu:        normal:   brightwhite:black

# Tables & Grid Data (CSS 2.1 Table Formatting)
table:       normal:   brightcyan:black
caption:     bold:     brightyellow:black
tr:          normal:   brightwhite:black
td:          normal:   brightwhite:black
th:          bold:     white:blue
thead:       bold:     white:blue
tbody:       normal:   brightwhite:black
tfoot:       bold:     lightgray:black
col:         normal:   brightwhite:black
colgroup:    normal:   brightwhite:black

# Interactive & Form Elements
form:        normal:   brightyellow:black
input:       bold:     white:blue
textarea:    bold:     white:blue
select:      bold:     white:blue
option:      normal:   brightwhite:black
optgroup:    bold:     brightyellow:black
button:      bold:     black:white
submit:      bold:     black:white
label:       bold:     brightyellow:black
fieldset:    normal:   brightcyan:black
legend:      bold:     brightyellow:black

# Scrollbar
scroll.bar:   bold:    white:blue
scroll.back:  normal:  lightgray:black
scroll.arrow: bold:    white:blue

# Source Code Highlighting (CSS / PrettySrc)
prettysrc:       normal: brightwhite:black
psrc:tag:        bold:   brightcyan:black
psrc:attr:       normal: brightmagenta:black
psrc:val:        normal: brightgreen:black
psrc:comment:    normal: lightgray:black
psrc:entity:     bold:   brightyellow:black
psrc:badcon:     bold:   white:red
